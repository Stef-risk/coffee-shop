# 复制此文件为 .env 并填入真实值
# IMPORTANT: 不要将 .env 提交到 Git！

# MetaMask钱包私钥（仅用测试账户，不要用有真实资产的账户！）
PRIVATE_KEY=your_private_key_here

# Alchemy RPC URL（在 https://alchemy.com 免费注册获取）
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key

# Etherscan API Key（在 https://etherscan.io 注册获取，用于验证合约）
ETHERSCAN_API_KEY=your_etherscan_api_key

# CoinMarketCap API Key（可选，用于Gas费用USD报告）
# COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
